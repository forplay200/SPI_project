# Local footage and generated media (privacy-sensitive and/or large)
input/*
!input/.gitkeep
*.mp4
*.mov
*.mkv
*.avi

# Generated outputs and evidence
output/draft/*
!output/draft/.gitkeep
output/final/*
!output/final/.gitkeep
temp/*
!temp/.gitkeep
evidence/logs/*
!evidence/logs/.gitkeep
evidence/reports/*
!evidence/reports/.gitkeep
evidence/approvals/*
!evidence/approvals/.gitkeep
evidence/screenshots/*
!evidence/screenshots/.gitkeep
evidence/ui/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Guided UI generated pipeline artefacts
config/project-*_project.json
config/project-*_sync.json
edl/project-*_editing_decisions.json

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
